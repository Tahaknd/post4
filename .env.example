# ---------------------------------------------------------------------------
# NOTE: When running with Docker Compose, most of the values below are set in
# docker-compose.yml (DB, Redis, Kafka, ClickHouse, logging, ...) and override
# this file. This file mainly documents the available variables.
#
# Compose-level variables (put them in a .env file next to docker-compose.yml):
# APP_KEY=            # auto-generated on first boot and stored in the app-storage volume if empty; back it up, `down -v` deletes it
# POSTGRES_PASSWORD=posthog    # only takes effect on first initialisation of the volume; change before first start in production
# CLICKHOUSE_PASSWORD=posthog  # only takes effect on first initialisation of the volume; change before first start in production
# CLICKHOUSE_RO_PASSWORD=posthog_ro    # password of the read-only ClickHouse user posthog_ro (fixed name, docker/clickhouse/users.d/20-readonly-user.xml); after changing it run `docker compose up -d --force-recreate clickhouse` and `docker compose up -d`; change before the first public start
# APP_BIND=0.0.0.0    # set to 127.0.0.1 when running behind a TLS reverse proxy
# APP_PORT=8000       # published host port
# OCTANE_WORKERS=4    # Octane worker count
# OCTANE_MAX_REQUESTS=500   # requests per Octane worker before restart
# HORIZON_MAX_PROCESSES=2   # max Horizon queue worker processes (the `maintenance` supervisor, which runs the ClickHouse event purge, always has exactly one)
# QUEUE_CONNECTION=redis    # MUST be redis: the project events purge and Horizon need it (Compose sets it). With sync or database the purge is not run by the Horizon worker
# TRUSTED_PROXIES=*  # reverse proxies whose X-Forwarded-For is trusted: '*' or comma-separated IPs/CIDRs. Set '*' only when APP_PORT is bound to 127.0.0.1 behind a proxy; unset = trust nothing.
#                    # REQUIRED behind a reverse proxy: every per-ip limiter (capture failures, sign-in throttle) keys on this ip, so without it all clients share the proxy's single address and ONE budget (Docker Desktop's NAT does the same on a dev machine)
# CAPTURE_PROJECT_EVENTS_PER_MINUTE=60000  # max events accepted per project per minute (over it: 503 + Retry-After); 0 disables
# CAPTURE_AUTH_FAIL_LIMIT=120  # unauthenticated capture failures allowed per client ip per window (over it: 429 + Retry-After)
# CAPTURE_AUTH_FAIL_WINDOW_SECONDS=60  # length of that failure window in seconds
# LOG_LEVEL=info      # log level (logs go to stderr under Compose)
# LOG_AUDIT_CHANNEL=audit  # send the structured project audit lines (project.create, project.delete, ...) to storage/logs/audit-*.log instead of the default channel; unset = default channel (stderr under Compose). Scripts that read stderr should not treat audit lines as warnings either way
# REDIS_MAXMEMORY=256mb          # maxmemory of the main Redis service (queues, Horizon, cache, limiters); 0 = unlimited
# REDIS_SESSIONS_MAXMEMORY=128mb # maxmemory of the redis-sessions service (sessions only, allkeys-lru, no persistence)
# REDIS_MAXMEMORY_POLICY=volatile-ttl  # eviction policy; see the comment above the redis service in docker-compose.yml before changing it
# LOGIN_THROTTLE_EMAIL_IP_LIMIT=5      # sign-in attempts per (email, ip) per window before 429 + Retry-After (a successful sign-in gives its attempt back)
# LOGIN_THROTTLE_IP_LIMIT=20           # sign-in attempts per ip per window (any email)
# LOGIN_THROTTLE_EMAIL_LIMIT=30        # sign-in attempts per email per window across all ips (rate limit only, never a lockout)
# LOGIN_THROTTLE_WINDOW_SECONDS=900    # length of that window
# ---------------------------------------------------------------------------

APP_NAME=post4
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Under Compose sessions live in their own Redis instance (the redis-sessions service) over a bounded
# `session` connection: docker-compose.yml sets SESSION_DRIVER=redis, SESSION_CONNECTION=session and
# REDIS_SESSION_HOST=redis-sessions. This file keeps the database driver so a plain `php artisan serve` with
# sqlite works without Redis; for Redis set SESSION_DRIVER=redis and SESSION_CONNECTION=session (the connection
# uses REDIS_SESSION_HOST/PORT/PASSWORD/DB, falling back to REDIS_HOST/PORT/PASSWORD and database 2).
SESSION_DRIVER=database
# Minutes a session may stay idle (rolling: every request renews it).
SESSION_LIFETIME=120
# The session cookie is Secure automatically when APP_URL starts with https://. Behind a reverse proxy that
# terminates TLS, APP_URL MUST be the public https URL (or set SESSION_SECURE_COOKIE=true explicitly), otherwise
# the cookie is sent without the Secure flag. SESSION_SECURE_COOKIE=true|false always overrides. Always HttpOnly,
# SameSite=Lax. Host header caveat: the application does not pin its host name (trustHosts would break access
# through localhost, 127.0.0.1 and LAN names), so generated URLs follow the request's Host header; keep the app
# behind a proxy that sets or validates Host if it is exposed to the internet.
# SESSION_SECURE_COOKIE=
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# INSIGHTS_CACHE_STORE=redis  # cache store of insight results (not CACHE_STORE: never the database store); config/insights.php
# INSIGHTS_MAX_ACTIVE_RUNS_PER_USER=8  # runs one user can have queued or running at once, across projects (429 busy above); config/insights.php
# INSIGHTS_MAX_ACTIVE_RUNS_PER_PROJECT=20  # runs one project can have queued or running at once
# INSIGHTS_MAX_CONCURRENT_QUERIES_PER_PROJECT=1  # ClickHouse queries of one project at once (2 workers, 3 ClickHouse slots)
# INSIGHTS_RUN_TTL_SECONDS=900  # INSIGHTS_FINISHED_TTL_SECONDS=300 INSIGHTS_LOCK_TTL_SECONDS=50 (above the 45 s job timeout, below retry_after)
# INSIGHTS_CACHE_TTL_SECONDS=60  # how long a successful insight result is reused; 0 disables the cache
# INSIGHTS_EVENTS_CACHE_TTL_SECONDS=120  # event-name list of the picker, per project and search text (60-300 sensible; 0 disables)
# INSIGHTS_EVENTS_MAX_EXECUTION_TIME=5  # ClickHouse seconds for that list (profile allows 1-22); INSIGHTS_EVENTS_LOCK_TTL_SECONDS=15 is its single slot
# REDIS_CACHE_TIMEOUT=0.5  # seconds to connect to the cache connection (limiters, project lookup)
# REDIS_CACHE_READ_TIMEOUT=1.0  # seconds to wait for a cache reply; the default connection (queues) stays unbounded
# REDIS_SESSION_HOST=  # Redis host of the session connection; unset = REDIS_HOST (Compose sets redis-sessions)
# REDIS_SESSION_DB=2  # database of the session connection on a shared Redis (0 = queues/Horizon, 1 = cache); Compose uses its own instance, database 0
# REDIS_SESSION_TIMEOUT=0.5  # seconds to connect to the session connection
# REDIS_SESSION_READ_TIMEOUT=1.0  # seconds to wait for a session reply

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Inertia DevTools record every request to disk; keep off outside local debugging.
INERTIA_DEVTOOLS_ENABLED=false
