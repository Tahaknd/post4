# ---------------------------------------------------------------------------
# Compose-level settings: `cp .env.example .env` next to docker-compose.yml, then uncomment what you change.
# Every line is commented out and shows the DEFAULT, so an untouched copy behaves like no file at all.
# docker-compose.yml reads this file for ${VAR} interpolation only; the app itself gets what the compose
# file passes on. For a bare `php artisan serve` run (no Docker) use .env.local.example instead.
# Changes apply on `docker compose up -d`; a bind-mounted XML file needs `--force-recreate clickhouse`.
# ---------------------------------------------------------------------------

# --- Exposure -------------------------------------------------------------
# APP_URL=http://localhost:8000   # public URL; https:// makes the session cookie Secure (use it behind a TLS proxy)
# APP_BIND=0.0.0.0                # 127.0.0.1 when a reverse proxy on this host terminates TLS
# APP_PORT=8000                   # published host port
# TRUSTED_PROXIES=                # '*' or IPs/CIDRs whose X-Forwarded-For is trusted; REQUIRED behind a proxy (per-ip limiters key on it); unset = trust nothing

# --- Secrets (change BEFORE the first start: the database volumes keep the first value) -----------------
# APP_KEY=                        # empty = generated on first boot into the app-storage volume (back it up: `down -v` deletes it)
# POSTGRES_PASSWORD=posthog
# CLICKHOUSE_PASSWORD=posthog
# CLICKHOUSE_RO_PASSWORD=posthog_ro   # read-only user posthog_ro; after changing: `docker compose up -d --force-recreate clickhouse` then `docker compose up -d`

# --- Memory (hard container limits; ClickHouse sizes itself to 0.7 of its limit) ----------------------
# CLICKHOUSE_MEM_LIMIT=3g         # 0 = unlimited (the ratio then applies to the host RAM). 3g gives ClickHouse about 2.25 GB
# REDIS_MAXMEMORY=256mb           # main Redis (queues, Horizon, cache, limiters); 0 = unlimited. REDIS_MEM_LIMIT=400m: keep it about 1.5x
# REDIS_SESSIONS_MAXMEMORY=128mb  # sessions Redis (allkeys-lru); REDIS_SESSIONS_MEM_LIMIT=200m
# APP_MEM_LIMIT=1500m             # WORKER_MEM_LIMIT=768m SCHEDULER_MEM_LIMIT=256m POSTGRES_MEM_LIMIT=512m KAFKA_MEM_LIMIT=1g

# --- Capture and privacy ---------------------------------------------------
# CAPTURE_STORE_IP=false          # keep the raw client ip as $ip (default false: used for GeoIP, then dropped)
# CAPTURE_PROJECT_EVENTS_PER_MINUTE=60000   # per project; over it 503 + Retry-After; 0 disables

# --- Process counts and logging -------------------------------------------
# OCTANE_WORKERS=4                # HTTP workers; OCTANE_MAX_REQUESTS=500 requests per worker before it restarts
# HORIZON_MAX_PROCESSES=2         # queue worker processes
# LOG_LEVEL=info                  # logs go to stderr (docker compose logs), rotated at 3 x 10 MB per container

# --- Optional app tuning knobs --------------------------------------------
# Passed to app, worker and scheduler only when set here or in the shell (see the environment block of
# docker-compose.yml): INSIGHTS_*, KAFKA_*, CLICKHOUSE_TIMEOUT / CLICKHOUSE_RO_*, SESSION_*, LOG_AUDIT_CHANNEL,
# INERTIA_ENCRYPT_HISTORY, CAPTURE_STATUS_*. Meaning and defaults of each: .env.local.example and config/*.php.
# Never write `NAME=` with an empty value: it is passed as an empty string (read as 0/false), not as "unset".
